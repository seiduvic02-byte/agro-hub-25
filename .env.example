# Copy to .env for local development. Never commit the populated .env file.
# Use a disposable/local MySQL database, never the production DATABASE_URL.
PORT=3000
DATABASE_URL=mysql://agrohub_dev:CHANGE_ME@127.0.0.1:3306/agrohub_dev

# Manus OAuth: needed for real local sign-in. Obtain values through the authorized
# project owner/secret manager. The local callback must be allowed by OAuth config.
MANUS_PROJECT_ID=
MANUS_OAUTH_PORTAL_URL=
MANUS_OAUTH_API_URL=
MANUS_JWT_SECRET=

# Optional Manus APIs used by map/media/LLM/transcription integrations.
# Keep MANUS_API_KEY server-only. The browser key is intentionally a public-scoped key.
MANUS_API_URL=
MANUS_API_KEY=
MANUS_API_BROWSER_KEY=

# Optional local admin bootstrap; leave blank unless explicitly configured by the owner.
OWNER_OPEN_ID=

# Production-only canonical origin (HTTPS required). Leave unset for localhost.
# PUBLIC_SITE_URL=https://www.example.com
# Optional public social-preview image.
# PUBLIC_OG_IMAGE_URL=https://www.example.com/og-image.png
